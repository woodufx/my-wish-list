# Base URL of the API. With MSW enabled this is the mock origin.
VITE_API_BASE_URL=/api

# Start MSW mocks in dev. Never enabled in production builds.
VITE_ENABLE_MOCKS=true

# --- Server-only secrets (NO VITE_ prefix — never exposed to the client bundle) ---

# Neon Postgres connection string (use the dev branch locally).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Long random string that grants owner (admin) access via a signed cookie.
OWNER_SECRET=change-me-to-a-long-random-string

# Secret used to sign the owner httpOnly cookie.
COOKIE_SECRET=change-me-to-another-long-random-string
